{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build:shared && npx prisma generate --schema apps/api/prisma/schema.prisma",
  "installCommand": "npm install --include=dev",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/jobs/sla-scan",
      "schedule": "0 3 * * *"
    }
  ]
}
