# HEURISTIC_MODE=true  -> no model downloads at all. Lexicon sentiment, rule-based
#                         burnout, z-score anomaly. Identical API contract.
#                         This is the default so the demo can NEVER break offline.
# HEURISTIC_MODE=false -> loads distilbert-base-uncased-finetuned-sst-2-english
#                         (~250MB, first run needs internet) + sklearn models.
HEURISTIC_MODE=true

# Where transformers caches model weights (kept out of git).
MODEL_CACHE_DIR=./models
PORT=8000
LOG_LEVEL=info
