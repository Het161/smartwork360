# ---------------------------------------------------------------- database
# Works against either `docker compose up -d` (postgres:16) or a local
# PostgreSQL — both use the same role/password/db name.
DATABASE_URL="postgresql://smartwork:smartwork@localhost:5432/smartwork360?schema=smartwork"

# ------------------------------------------------------------------ server
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed browser origins.
CORS_ORIGIN="http://localhost:3000"

# -------------------------------------------------------------------- auth
# Access token lifetime is short; refresh token lives in an httpOnly cookie.
JWT_ACCESS_SECRET="smartwork360-access-secret-change-me"
JWT_REFRESH_SECRET="smartwork360-refresh-secret-change-me"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL="7d"

# Mock Parichay SSO (sandbox only — NOT a real NIC integration).
PARICHAY_SANDBOX_OTP="123456"

# ---------------------------------------------------------------------- ml
# If the ML service is unreachable the API degrades gracefully to stored values.
ML_SERVICE_URL="http://localhost:8000"
ML_TIMEOUT_MS=8000

# ------------------------------------------------------------------- cron
# SLA breach scanner. Set to false to silence it during a demo.
ENABLE_SLA_CRON=true
LOG_LEVEL=info

# ------------------------------------------------------------------- mail
# console  (default) — prints the OTP to this terminal. No network needed;
#                      the demo works on a venue with no wifi.
# ethereal           — creates a throwaway inbox and logs a preview URL so you
#                      can show judges the real branded email.
# smtp               — a real provider (Gmail app password, Resend, …).
MAIL_MODE=console
MAIL_FROM="SMARTWORK 360 <no-reply@smartwork360.gov.in>"

# Only needed when MAIL_MODE=smtp.
# Gmail: create an App Password at https://myaccount.google.com/apppasswords
# (a normal account password will NOT work with 2FA enabled).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.address@gmail.com
SMTP_PASS=your-16-char-app-password

# ------------------------------------------------------------- onboarding
# Domains permitted to self-register. Subdomains are matched too (x.gov.in).
ALLOWED_EMAIL_DOMAINS=gov.in,nic.in
# Used in the welcome email's sign-in link.
APP_BASE_URL=http://localhost:3000
SIGNUP_RATE_LIMIT_PER_HOUR=5

# ------------------------------------------------------- saarthi support bot
# Any OpenAI-compatible chat-completions endpoint. Defaults target Groq; for
# xAI use https://api.x.ai/v1 with an xai-... key and a grok-* model id.
# Model ids move between releases — check the provider's model list, never
# hard-code one in source.
SUPPORT_LLM_API_KEY=
SUPPORT_LLM_BASE_URL=https://api.groq.com/openai/v1
SUPPORT_LLM_MODEL=openai/gpt-oss-120b
SUPPORT_LLM_MODEL_FAST=llama-3.1-8b-instant
SUPPORT_LLM_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
SUPPORT_GUARD_THRESHOLD=0.8
# auto = use the model when a key is present; offline = deterministic, no network.
# The demo is rehearsed in offline mode — auto-fix works either way.
SUPPORT_BOT_MODE=auto
SUPPORT_AUTOFIX_ENABLED=true
SUPPORT_MAX_FIXES_PER_HOUR=5
SUPPORT_UNDO_WINDOW_MIN=15
